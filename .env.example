# ARES Accord - copy to .env and fill in ONLY the provider you use. Never commit .env.
# Default provider used by the dashboard: rule-based | gemini | groq | openrouter | ollama
ARES_PROVIDER=rule-based

# Google Gemini (free tier via Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=

# Groq (free tier)
GROQ_API_KEY=
GROQ_MODEL=

# OpenRouter (use a model id ending in :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Ollama (local, no key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Limits
ARES_LLM_TIMEOUT_S=25
ARES_LLM_MAX_RETRIES=2
ARES_LLM_MIN_INTERVAL_S=0
ARES_SCENARIO_DEADLINE_S=170
ARES_DB_PATH=data/ares.db
