# ARES Accord - copy to .env and fill in ONLY the provider you use. Never commit .env.
# Default provider used by the dashboard: rule-based | gemini | groq | openrouter | ollama
ARES_PROVIDER=rule-based

# Google Gemini (free tier via Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=

# Groq (free tier)
GROQ_API_KEY=
GROQ_MODEL=

# OpenRouter (use a model id ending in :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Set to 1 to allow a paid (non-:free) OpenRouter model. Leave empty to stay on free models only.
OPENROUTER_ALLOW_PAID=

# Ollama (local, no key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Limits. Non-numeric or non-finite values (nan/inf) fall back to the default with a logged warning (retries:
# silently). Negative deadlines are ignored the same way; LLM timing and retry values are clamped as noted.
# Per-call LLM budget in seconds, including retries (minimum 2).
ARES_LLM_TIMEOUT_S=25
# Retries per LLM call (clamped to 0..5).
ARES_LLM_MAX_RETRIES=2
# Seconds between calls to the same provider. 0/empty = each provider's built-in pacing.
ARES_LLM_MIN_INTERVAL_S=0
# Optional per-provider pacing override (0 allowed), e.g. ARES_GEMINI_MIN_INTERVAL_S=4
# ARES_GEMINI_MIN_INTERVAL_S=
# ARES_GROQ_MIN_INTERVAL_S=
# ARES_OPENROUTER_MIN_INTERVAL_S=
# ARES_OLLAMA_MIN_INTERVAL_S=
# Wall-clock budget for a crisis-event run (seconds) and for the baseline run.
ARES_SCENARIO_DEADLINE_S=170
ARES_BASELINE_DEADLINE_S=600
ARES_DB_PATH=data/ares.db
# Log level for the ares logger: DEBUG | INFO | WARNING | ERROR (invalid values fall back to INFO with a warning).
# In the dashboard a value set only here applies from the first rerun; set it in the environment for startup.
ARES_LOG_LEVEL=INFO
